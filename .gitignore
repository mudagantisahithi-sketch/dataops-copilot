@"
# Python
.venv/
__pycache__/
*.py[cod]

# Secrets
.env
.env.*
!.env.example

# ADK local state
.adk/
**/.adk/

# Temporary files
tmp/
agent/tmp/

# Credentials
credentials/
*-credentials.json
service-account*.json
*.key
*.pem
*.p12

# Logs
*.log

# Local/editor files
.vscode/
.idea/
.DS_Store

# Local MCP Toolbox binary
toolbox.exe

# Generated/runtime data
data/*.csv
incoming/*.csv
reports/*.json
pipeline_status.json
realtime_status.json
"@ | Set-Content .gitignore -Encoding utf8
