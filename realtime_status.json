import time
import subprocess
import sys
from pathlib import Path
from datetime import datetime

# ============================================================
# DATAOPS COPILOT - REAL-TIME PIPELINE MONITOR
# ============================================================

BASE_DIR = Path(__file__).resolve().parent

INCOMING_DIR = BASE_DIR / "incoming"
COPILOT = BASE_DIR / "copilot.py"

INCOMING_DIR.mkdir(
    exist_ok=True
)

PYTHON = sys.executable

processed_files = set()

print("=" * 60)
print("       DATAOPS COPILOT - REAL-TIME PIPELINE")
print("=" * 60)

print()
print(f"Watching: {INCOMING_DIR}")
print()
print("Drop a CSV file into the incoming folder.")
print("The pipeline will automatically process it.")
print()
print("Press Ctrl+C to stop.")
print()


def wait_until_file_ready(csv_file):

    previous_size = -1

    for _ in range(30):

        try:

            current_size = csv_file.stat().st_size

        except FileNotFoundError:

            return False

        if current_size == previous_size:

            return True

        previous_size = current_size

        time.sleep(1)

    return False


def process_file(csv_file):

    print()
    print("=" * 60)
    print("NEW FILE DETECTED")
    print("=" * 60)

    print()
    print(f"File: {csv_file.name}")

    print()
    print(
        f"Detected at: "
        f"{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}"
    )

    print()
    print("Starting DataOps Copilot...")

    try:

        result = subprocess.run(
            [
                PYTHON,
                str(COPILOT),
                str(csv_file)
            ],
            cwd=BASE_DIR,
            text=True
        )

        print()

        if result.returncode == 0:

            print("=" * 60)
            print("COPILOT PIPELINE COMPLETED")
            print("=" * 60)

        else:

            print("=" * 60)
            print("COPILOT PIPELINE FAILED")
            print("=" * 60)

    except Exception as e:

        print()
        print("=" * 60)
        print("PIPELINE ERROR")
        print("=" * 60)

        print(str(e))


def scan_folder():

    csv_files = list(
        INCOMING_DIR.glob("*.csv")
    )

    for csv_file in csv_files:

        file_key = str(
            csv_file.resolve()
        )

        if file_key in processed_files:
            continue

        print()
        print(
            f"Checking new file: "
            f"{csv_file.name}"
        )

        if not wait_until_file_ready(
            csv_file
        ):

            print(
                "File is still being copied. "
                "Waiting..."
            )

            continue

        processed_files.add(
            file_key
        )

        process_file(
            csv_file
        )


try:

    while True:

        scan_folder()

        time.sleep(2)

except KeyboardInterrupt:

    print()
    print("=" * 60)
    print("REAL-TIME MONITOR STOPPED")
    print("=" * 60)
