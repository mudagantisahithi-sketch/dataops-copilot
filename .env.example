# Backend selection
USE_MOCK_BACKEND=true       # true = local SQLite/filesystem, no GCP creds needed
LLM_BACKEND=none            # none | gemini | anthropic

# Required only when USE_MOCK_BACKEND=false
GCP_PROJECT_ID=
BQ_DATASET=dataops
BQ_LOCATION=US
GCS_BUCKET=
PUBSUB_TOPIC=dataops-incidents

# Required only when LLM_BACKEND=gemini (Google ADK + Gemini API)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Required only when LLM_BACKEND=anthropic (secondary local dev path)
ANTHROPIC_API_KEY=

# Used by streamlit_app.py to reach the FastAPI service
DATAOPS_API_URL=http://localhost:8000
