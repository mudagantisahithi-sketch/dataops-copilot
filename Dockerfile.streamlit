FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir fastapi==0.115.0 pydantic==2.9.2 pandas==2.2.2 \
        streamlit==1.38.0 requests==2.32.3

COPY . .

ENV PORT=8501
EXPOSE 8501

CMD exec streamlit run streamlit_app.py --server.port=${PORT} --server.address=0.0.0.0
